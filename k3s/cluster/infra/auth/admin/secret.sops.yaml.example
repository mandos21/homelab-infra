# Copy this file to secret.sops.yaml, replace the values, and encrypt it with:
#   sops -e -i k3s/cluster/infra/auth/admin/secret.sops.yaml
# Then add secret.sops.yaml to kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: admin-auth-secrets
  namespace: traefik-system
type: Opaque
stringData:
  client-id: admin-auth
  client-secret: REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
  cookie-secret: REPLACE_WITH_32_BYTE_BASE64_COOKIE_SECRET
